# The RELATE_* lines below are commented out on purpose: an empty value is rejected by
# RelateSaver, so uncomment a line only after giving it a value.

# Optional: path of the Relate database file. Default: :memory: (no file is written).
# RELATE_DB_PATH=

# Optional: write-ahead logging for file stores (1/true/yes/on or 0/false/no/off). Default: true.
# RELATE_WAL_ENABLED=

# Optional: seconds to wait for the writer thread before a call times out. Default: 30.0.
# RELATE_PROXY_TIMEOUT_SEC=

# Optional: log level (DEBUG, INFO, WARNING, ERROR, CRITICAL). Default: INFO.
# RELATE_LOG_LEVEL=

# Optional: only for examples/openrouter_agent.py (recorded LLM run). Export it in your shell;
# the script reads the process environment and never a .env file. No default.
OPENROUTER_API_KEY=
